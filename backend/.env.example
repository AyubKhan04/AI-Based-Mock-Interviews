# Copy to .env for local use, or paste these into Render > Environment. Never commit real values.
DATABASE_URL=sqlite:///./mockinterview.db
JWT_SECRET=paste-a-long-random-string-here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_ORIGINS=http://localhost:5173
# Email (optional): either Gmail SMTP with an App Password...
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# ...or Brevo's free API (use this on Render, which blocks SMTP on the free plan)
BREVO_API_KEY=
CRON_SECRET=
FRONTEND_URL=http://localhost:5173
